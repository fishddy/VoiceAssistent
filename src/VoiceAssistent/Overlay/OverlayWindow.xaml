<Window x:Class="VoiceAssistent.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Assistent"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Height">
    <Border x:Name="Container"
            Padding="18,14"
            BorderThickness="1"
            BorderBrush="#33FFFFFF">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Ellipse Width="8" Height="8" Fill="#FFD97757" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText"
                           Margin="8,0,0,0"
                           FontSize="12"
                           Foreground="#B3FFFFFF"
                           VerticalAlignment="Center" />
            </StackPanel>
            <ScrollViewer x:Name="ConversationScroller"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ConversationPanel">
                    <ItemsControl x:Name="ExchangeList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Question}" Foreground="White" TextWrapping="Wrap" />
                                    <Border x:Name="AnswerCard"
                                            Margin="14,6,0,0"
                                            Padding="10,6,10,8"
                                            Background="#1FFFFFFF"
                                            BorderBrush="#FFD97757"
                                            BorderThickness="3,0,0,0"
                                            CornerRadius="0,8,8,0">
                                        <StackPanel>
                                            <TextBlock Text="ChatGPT"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFD97757"
                                                       Margin="0,0,0,2" />
                                            <TextBlock x:Name="AnswerText"
                                                       Text="{Binding Answer}"
                                                       Foreground="#E6FFFFFF"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding AnswerState}" Value="None">
                                        <Setter TargetName="AnswerCard" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AnswerState}" Value="Waiting">
                                        <Setter TargetName="AnswerText" Property="Text" Value="Thinking…" />
                                        <Setter TargetName="AnswerText" Property="FontStyle" Value="Italic" />
                                        <Setter TargetName="AnswerText" Property="Foreground" Value="#80FFFFFF" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AnswerState}" Value="Failed">
                                        <Setter TargetName="AnswerText" Property="Foreground" Value="#FFFF8A80" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="DraftText" TextWrapping="Wrap" Visibility="Collapsed">
                        <Run x:Name="FinalRun" Foreground="White" />
                        <Run x:Name="PartialRun" Foreground="#99FFFFFF" />
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
