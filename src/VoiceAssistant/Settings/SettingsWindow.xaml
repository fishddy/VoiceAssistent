<Window x:Class="VoiceAssistant.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Assistant Settings"
        SizeToContent="Height"
        Width="760"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="FirstSectionHeader" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,2" />
            <Setter Property="Foreground" Value="#444444" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="MultiLineBox" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Height" Value="54" />
        </Style>
    </Window.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Microphone" Style="{StaticResource FirstSectionHeader}" />
            <ComboBox x:Name="InputDeviceBox" DisplayMemberPath="Label" SelectionChanged="OnInputDeviceChanged" />
            <ProgressBar x:Name="InputLevelBar" Height="5" Minimum="0" Maximum="1" Margin="0,6,0,0" />
            <TextBlock x:Name="InputLevelHint" Style="{StaticResource Hint}" />

            <TextBlock Text="Box position" Style="{StaticResource SectionHeader}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Corner of the main monitor" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="CornerBox" DisplayMemberPath="Label" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Edge distance (px)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="MarginBox" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Speech recognition" Style="{StaticResource SectionHeader}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Language" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <ComboBox x:Name="LanguageBox" Grid.Column="1" DisplayMemberPath="Label" Margin="0,2" />
                <TextBlock Text="Model" Grid.Row="1" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <ComboBox x:Name="ModelBox" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Label" Margin="0,2" />
            </Grid>
            <TextBlock Text="A new model is downloaded once when you save." Style="{StaticResource Hint}" />
        </StackPanel>

        <StackPanel Grid.Column="2">
            <TextBlock Text="Phrases" Style="{StaticResource FirstSectionHeader}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Open the box" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="WakePhrasesBox" Style="{StaticResource MultiLineBox}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Close the box" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ClosePhrasesBox" Style="{StaticResource MultiLineBox}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="One phrase per line." Style="{StaticResource Hint}" />

            <TextBlock Text="ChatGPT" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="Instructions sent with each question" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="ChatInstructionsBox" Style="{StaticResource MultiLineBox}" Height="72" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Send after a pause of" VerticalAlignment="Center" Foreground="#444444" />
                <TextBox x:Name="SendAfterPauseBox" Width="44" Margin="6,0" VerticalContentAlignment="Center" />
                <TextBlock Text="seconds" VerticalAlignment="Center" Foreground="#444444" />
            </StackPanel>        </StackPanel>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Save" Width="80" IsDefault="True" Click="OnSaveClicked" />
                <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
            <TextBlock x:Name="ErrorText"
                       Foreground="Firebrick"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Visibility="Collapsed" />
        </DockPanel>
    </Grid>
</Window>
